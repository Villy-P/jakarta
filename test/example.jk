import * from "math.jk" as math;

typedef Dogs uint

func uint factorial(uint n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n);
}

func uint main(str[] argv) {
    str input_file;
    str output_file;
    for (uint i := 2 ... argv.len; i++) {
        if (argv[i] == "-f") {
            if (i == argv.len - 1) {
                jakarta_error_no_file_location("-f");
            }
            input_file := argv[i + 1];
        } else if (argv[i] == "-o") {
            if (i == argv.len - 1) {
                jakarta_error_no_file_location("-o");
            }
            output_file := argv[i + 1];
        }
    }
    jakarta_cmd_read_file(input_file);
    jakarta_cmd_out_file(output_file);

    println(output_file);
}

class Node<E> {
    pub E val;
    pub Node<E> next;
    pub ulong i;

    pub constructor(E e) {
        this.val := e;
    }
}


class List<E> {
    private Node<E> head;

    pub void add(E e) {
        constant Node<E> node = new Node(e) {
            i := 23
        };
        if (this.head == nul) {
            this.head := node;
            ret;
        }
        Node<E> current = this.head;
        while (current.next != nul) {
            current := current.next;
        }
        current.next := node;
    }
}