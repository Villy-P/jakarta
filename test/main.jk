import "lib/stdio.jk";

int DEFAULT_ERROR_CODE = 0;

typedef factorial_type uint;

func int main() {
    factorial_type f10 = factorial(10);

    print(f10 - f5, print(f5, f10 + 400));

    ret 0;
}

func factorial_type factorial(factorial_type n) {
    if (n == 0) {
        ret 1;
    }
    ret n * factorial(n - 1);
}
