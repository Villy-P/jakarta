import "lib/stdio.jk";

int DEFAULT_ERROR_CODE = 0;

typedef factorial_type uint;

func int main() {
    factorial_type f10 = factorial(10);
    factorial_type f5 = factorial(5);

    print(f10 + " " + f5);

    ret DEFAULT_ERROR_CODE;
}

func factorial_type factorial(factorial_type n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n - 1);
}

func factorial_type factorial(factorial_type n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n - 1);
}

func factorial_type factorial(factorial_type n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n - 1);
}