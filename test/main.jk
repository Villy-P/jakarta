// import "stdio"

typedef Students ubyte;
typedef Decimal double;

func void print(string input) {
    write(input);
}

func uint factorial(uint n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n);
}

func int main() {
    uint f10 = factorial(10);
    uint f5 = factorial(5);

    // print(f10 + " " + f5);

    ret 0;
}
