// import "stdio"

class string {
    char[] data;
    uint length;

    func char index(uint n) {
        // ERRORS
        ret data[n];
    }
}

func void print(string input) {
    for (int i = 0; i < input; i++) {
        write(input[i]);
    }
}

func uint factorial(uint n) {
    if (n == 0) {
        ret 0;
    }
    ret n * factorial(n);
}

func int main() {
    uint f10 = factorial(10);
    uint f5 = factorial(5);

    print(f10 + 10 + f5);

    ret 0;
}
